{
  "name": "geonft",
  "version": "1.0.0",
  "description": "Digital certificates for geological samples and data: each core, test or survey becomes an ERC-721 token with location, depth, lab results and file hashes, with revisions, revocation and chain of custody.",
  "license": "MIT",
  "author": "Cauê Somensi",
  "contributors": [
    "Claude (Anthropic)"
  ],
  "homepage": "https://github.com/Caumaker/GeoNFT#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caumaker/GeoNFT.git"
  },
  "keywords": [
    "nft",
    "erc721",
    "geology",
    "geotechnical",
    "ags4",
    "geojson",
    "polygon",
    "chain-of-custody",
    "drill-core"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test && node --test tools/test/*.test.js",
    "from-ags": "node tools/ags4-to-geonft.js",
    "validate": "node tools/validate.js",
    "hash": "node tools/hash.js",
    "deploy": "hardhat run scripts/deploy.js",
    "mint": "hardhat run scripts/mint.js",
    "verify-token": "node tools/verify-token.js",
    "demo": "hardhat run scripts/demo.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.4",
    "chai": "^4.5.0",
    "hardhat": "^2.29.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "ajv": "^8.20.0",
    "ethers": "^6.17.0"
  }
}
